# --- XRP Ledger ---
# Devnet has the Credentials (XLS-70) + Permissioned Domains (XLS-80) amendments.
XRPL_ENDPOINT=wss://s.devnet.rippletest.net:51233
XRPL_JSON_RPC=https://s.devnet.rippletest.net:51234

# --- LLM agent (optional; degrades to deterministic fallback intents) ---
LLM_PROVIDER=anthropic          # anthropic | none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Settlement ---
# Symbolic on-chain settlement amount: XRP sent per RLUSD of intent value, so a
# 3000-RLUSD intent settles as 3000 * XRP_PER_RLUSD XRP on the testnet (the true
# RLUSD figure is recorded in the transaction memo). Keeps demos within faucet
# balances. Set RLUSD_ISSUER to settle in a real RLUSD IOU instead.
XRP_PER_RLUSD=0.001
RLUSD_ISSUER=

# --- Wallet seeds (written by scripts/00_setup_accounts.py) ---
RECIPIENT_SEED=
AGENT_SEED=
ISSUER_SEED=
